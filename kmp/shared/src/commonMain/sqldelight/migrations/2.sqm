-- 2 → 3（也会在 1→3 的链式升级里，于 1.sqm 之后执行）。
-- 历史上这份文件只有「本应属于 1→2」的账号/小组件表，且头注释误写成 1→2；
-- 同时把 v3 的新表也塞了进来。现在：1→2 的内容挪到 1.sqm，这里只负责 2→3。
--
-- 约束：
--  * 所有 CREATE 都带 IF NOT EXISTS —— 因为存在「从 v1 升上来的 v2 安装」没跑过
--    1→2 迁移的场景，2.sqm 必须把 1.sqm 的表也重建一遍，且不能与已有表冲突。
--  * 只有 sync_queue 的 7 个新增列走 ALTER。它们在所有 1→3 / 2→3 路径上都
--    「保证不存在」（v1/v2 的 sync_queue 恒为 4 列，1.sqm 不动它，2.sqm 只跑一次），
--    因此非幂等的 ALTER 是安全的；不 DROP 以免丢掉队列里待重放的同步行。
--    SQLite 的 ALTER 只能把列追加在末尾，但 SQLDelight 生成的查询全部按列名取数
--    （SELECT sync_queue.id, ...），列序差异不影响正确性。

-- 1.sqm 的表在这里用 IF NOT EXISTS 重放一次：由 v1 升上来的 v2 安装没跑过 1→2。
CREATE TABLE IF NOT EXISTS member_profile (
  id INTEGER NOT NULL PRIMARY KEY,
  nickname TEXT NOT NULL DEFAULT '',
  phone TEXT NOT NULL DEFAULT '',
  login_type TEXT NOT NULL DEFAULT '',
  bind_type TEXT NOT NULL DEFAULT '',
  bind_id TEXT NOT NULL DEFAULT '',
  vip INTEGER NOT NULL DEFAULT 0,
  vip_expire INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS sms_code (
  phone TEXT NOT NULL PRIMARY KEY,
  code TEXT NOT NULL DEFAULT '',
  expires INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS member_import_bill_file (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL DEFAULT '',
  type TEXT NOT NULL DEFAULT '',
  count INTEGER NOT NULL DEFAULT 0,
  status INTEGER NOT NULL DEFAULT 0,
  create_time INTEGER NOT NULL DEFAULT 0,
  content TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS member_order (
  id TEXT NOT NULL PRIMARY KEY,
  money INTEGER NOT NULL DEFAULT 0,
  method TEXT NOT NULL DEFAULT '',
  type INTEGER NOT NULL DEFAULT 0,
  product_id TEXT NOT NULL DEFAULT '',
  product_name TEXT NOT NULL DEFAULT '',
  status INTEGER NOT NULL DEFAULT 0,
  create_time INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS contract_info (
  id INTEGER NOT NULL PRIMARY KEY,
  signed INTEGER NOT NULL DEFAULT 0,
  provider TEXT NOT NULL DEFAULT '',
  product_name TEXT NOT NULL DEFAULT '',
  money INTEGER NOT NULL DEFAULT 0,
  next_date TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS behavior_event (
  id TEXT NOT NULL PRIMARY KEY,
  kind TEXT NOT NULL DEFAULT '',
  content TEXT NOT NULL DEFAULT '',
  contact TEXT NOT NULL DEFAULT '',
  create_time INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS widget_user (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL DEFAULT '',
  size TEXT NOT NULL DEFAULT 'small',
  kind TEXT NOT NULL DEFAULT 'month',
  create_time INTEGER NOT NULL DEFAULT 0
);

-- v3 新增表，全部 IF NOT EXISTS。
CREATE TABLE IF NOT EXISTS bill_tag (
  client_id TEXT NOT NULL,
  member_id INTEGER NOT NULL DEFAULT 0,
  tag_id INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (client_id, member_id, tag_id)
);

CREATE TABLE IF NOT EXISTS bill_remark (
  client_id TEXT NOT NULL,
  member_id INTEGER NOT NULL DEFAULT 0,
  content TEXT NOT NULL DEFAULT '',
  images TEXT NOT NULL DEFAULT '',
  create_date INTEGER NOT NULL DEFAULT 0,
  update_date INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (client_id, member_id)
);

CREATE TABLE IF NOT EXISTS cate_extend (
  member_cate_id INTEGER NOT NULL,
  book_id INTEGER NOT NULL DEFAULT 0,
  member_id INTEGER NOT NULL DEFAULT 0,
  type INTEGER NOT NULL DEFAULT 1,
  sort INTEGER NOT NULL DEFAULT 0,
  hidden INTEGER NOT NULL DEFAULT 0,
  status INTEGER NOT NULL DEFAULT 0,
  create_date INTEGER NOT NULL DEFAULT 0,
  update_date INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (member_cate_id, book_id, member_id)
);

CREATE TABLE IF NOT EXISTS member_assets (
  member_id INTEGER NOT NULL,
  book_id INTEGER NOT NULL DEFAULT 0,
  appear INTEGER NOT NULL DEFAULT 0,
  income INTEGER NOT NULL DEFAULT 0,
  is_master INTEGER NOT NULL DEFAULT 0,
  join_date INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (member_id, book_id)
);

CREATE TABLE IF NOT EXISTS image_info (
  id TEXT NOT NULL PRIMARY KEY,
  client_id TEXT NOT NULL DEFAULT '',
  path TEXT NOT NULL DEFAULT '',
  url TEXT NOT NULL DEFAULT '',
  source INTEGER NOT NULL DEFAULT 0,
  create_date INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS widget_base (
  id TEXT NOT NULL PRIMARY KEY,
  kind TEXT NOT NULL DEFAULT '',
  background TEXT NOT NULL DEFAULT '',
  transparency INTEGER NOT NULL DEFAULT 100,
  text_color TEXT NOT NULL DEFAULT '#0C0C09',
  show_bills INTEGER NOT NULL DEFAULT 1,
  update_time INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS widget_desktop (
  id TEXT NOT NULL PRIMARY KEY,
  widget_id TEXT NOT NULL DEFAULT '',
  size TEXT NOT NULL DEFAULT 'small',
  position INTEGER NOT NULL DEFAULT 0,
  config TEXT NOT NULL DEFAULT '',
  update_time INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS widget_hot (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL DEFAULT '',
  path TEXT NOT NULL DEFAULT '',
  count INTEGER NOT NULL DEFAULT 0,
  update_time INTEGER NOT NULL DEFAULT 0
);

-- sync_queue：v1/v2 是 4 列（id/path/payload/create_time），v3 扩成 11 列。
-- 只补 7 个「保证不存在」的新列，类型与默认值逐字对齐 S2.sq 的 CREATE TABLE。
ALTER TABLE sync_queue ADD COLUMN method TEXT NOT NULL DEFAULT 'POST';
ALTER TABLE sync_queue ADD COLUMN client_id TEXT NOT NULL DEFAULT '';
ALTER TABLE sync_queue ADD COLUMN status INTEGER NOT NULL DEFAULT 0;
ALTER TABLE sync_queue ADD COLUMN retry_count INTEGER NOT NULL DEFAULT 0;
ALTER TABLE sync_queue ADD COLUMN next_attempt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE sync_queue ADD COLUMN update_time INTEGER NOT NULL DEFAULT 0;
ALTER TABLE sync_queue ADD COLUMN error TEXT NOT NULL DEFAULT '';

-- 索引必须在列补齐之后创建。
CREATE INDEX IF NOT EXISTS sync_queue_status ON sync_queue(status, next_attempt);
