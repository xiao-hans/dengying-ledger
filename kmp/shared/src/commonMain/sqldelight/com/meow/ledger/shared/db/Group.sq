-- 本地拼团记录。show_id 是用户自拟的展示码，用来回查。
CREATE TABLE group_vip (
  id TEXT NOT NULL PRIMARY KEY,
  show_id TEXT NOT NULL DEFAULT '',
  status INTEGER NOT NULL DEFAULT 0,
  create_time INTEGER NOT NULL DEFAULT 0
);

selectGroups:
SELECT * FROM group_vip ORDER BY id;

selectGroup:
SELECT * FROM group_vip WHERE show_id = :showId;

upsertGroup:
INSERT OR REPLACE INTO group_vip(id, show_id, status, create_time) VALUES ?;
