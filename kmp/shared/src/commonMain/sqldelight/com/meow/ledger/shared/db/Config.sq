-- 远程开关与配置，value 存 JSON 字符串。
CREATE TABLE remote_config (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL DEFAULT '',
  update_time INTEGER NOT NULL DEFAULT 0
);

selectOne:
SELECT * FROM remote_config WHERE key = :key;

upsert:
INSERT OR REPLACE INTO remote_config(key, value, update_time) VALUES ?;

-- 用户设置（深浅色、应用锁等）。
CREATE TABLE user_setting (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL DEFAULT ''
);

selectSetting:
SELECT value FROM user_setting WHERE key = :key;

upsertSetting:
INSERT OR REPLACE INTO user_setting(key, value) VALUES ?;
